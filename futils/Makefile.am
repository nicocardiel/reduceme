noinst_LIBRARIES = libfutils.a
# the module file includes the files with the procedures
libfutils_a_SOURCES = futils_m.f90 freadline.c

# module with the global parameters and variables (generated by configure)
nodist_libfutils_a_SOURCES = redlib_m.f90

FUTILS_ROUTINES = avoid_warkings.f90 chlower.f90 chupper.f90 endprogram.f90 findmm.f90 \
	findmml.f90 findmmlmask.f90 lrunx.f90 read2i.f90 readc.f90 \
	readc_file.f90 readf.f90 readi.f90 readilim.f90 retorna_ticks.f90 \
	rmblank.f90 showperc.f90 systemfunction.f90 truebeg.f90 truelen.f90
EXTRA_DIST = $(FUTILS_ROUTINES)
futils_m.$(OBJEXT): $(FUTILS_ROUTINES)

AM_FCFLAGS = -I.
CLEANFILES = *.mod
